@baseUrl = http://localhost:4000
@api = {{baseUrl}}/api/v1

### Health — expect 200, status "ok"
GET {{baseUrl}}/health

### Brands — expect 11, alphabetical
GET {{api}}/brands


############################## GEAR — LIST ##############################

### Default — expect 12 items, meta.total 21, totalPages 2
GET {{api}}/gear

### Page 2 — expect 9 items
GET {{api}}/gear?page=2

### Past the end — expect 200 with an empty array, NOT 404
GET {{api}}/gear?page=3

### Category — expect total 8
GET {{api}}/gear?category=lenses

### Brand — expect total 5
GET {{api}}/gear?brand=canon

### Mount + price — expect the two Sigmas
GET {{api}}/gear?mount=E&maxCents=4000

### Text search, case-insensitive — expect 3
GET {{api}}/gear?q=SONY

### Combined filter and sort — expect 8, Sony FE 70-200 first
GET {{api}}/gear?category=lenses&sort=price-desc

### No matches — expect 200 with an empty array
GET {{api}}/gear?category=drones


############################## GEAR — DETAIL ##############################

### By slug — expect 200, specs.kind "body", 2 units
GET {{api}}/gear/canon-eos-r5

### By slug — expect 200, specs.kind "lens"
GET {{api}}/gear/sigma-35mm-f14-dg-dn-art


############################## EXPECTED FAILURES ##############################

### Unknown slug — expect 404 NOT_FOUND
GET {{api}}/gear/does-not-exist

### Malformed slug — expect 400 VALIDATION_ERROR
GET {{api}}/gear/Canon%20EOS

### Non-numeric page — expect 400 VALIDATION_ERROR
GET {{api}}/gear?page=abc

### Invalid sort — expect 400 listing the valid options
GET {{api}}/gear?sort=cheapest

### Page size above the cap — expect 400
GET {{api}}/gear?perPage=10000

### Min greater than max — expect 400
GET {{api}}/gear?minCents=9000&maxCents=1000

### Unknown route — expect 404 NOT_FOUND
GET {{api}}/nope


### Categories — expect 5
GET {{api}}/categories

############################## AVAILABILITY ##############################

### Free window — expect unavailableDates: []
GET {{api}}/gear/canon-eos-r5/availability?from=2026-03-01&to=2026-03-15

### Unknown slug — expect 404 NOT_FOUND
GET {{api}}/gear/does-not-exist/availability?from=2026-03-01&to=2026-03-15

### Bad date format — expect 400 VALIDATION_ERROR
GET {{api}}/gear/canon-eos-r5/availability?from=01-03-2026&to=2026-03-15

### Reversed range — expect 400
GET {{api}}/gear/canon-eos-r5/availability?from=2026-03-15&to=2026-03-01

### Window too long — expect 400
GET {{api}}/gear/canon-eos-r5/availability?from=2026-01-01&to=2026-12-31

###############################################
# Bookings — quote (F3)
###############################################

### Quote a two-line cart — expect 200, two priced lines
POST {{api}}/bookings/quote
Content-Type: application/json

{
  "lines": [
    { "slug": "canon-eos-r5", "start": "2026-10-06", "end": "2026-10-09" },
    { "slug": "canon-eos-r5", "start": "2026-10-20", "end": "2026-10-22" }
  ]
}

### Weekly rate kicks in — expect subtotal capped below days x daily
POST {{api}}/bookings/quote
Content-Type: application/json

{
  "lines": [{ "slug": "canon-eos-r5", "start": "2026-10-01", "end": "2026-10-14" }]
}

### Unknown slug — expect 404
POST {{api}}/bookings/quote
Content-Type: application/json

{ "lines": [{ "slug": "not-a-real-camera", "start": "2026-10-06", "end": "2026-10-09" }] }

### Dates in the past — expect 400 DATE_IN_PAST
POST {{api}}/bookings/quote
Content-Type: application/json

{ "lines": [{ "slug": "canon-eos-r5", "start": "2020-01-01", "end": "2020-01-03" }] }

### End before start — expect 400
POST {{api}}/bookings/quote
Content-Type: application/json

{ "lines": [{ "slug": "canon-eos-r5", "start": "2026-10-09", "end": "2026-10-06" }] }

### Malformed date — expect 400, ONE message about the format
POST {{api}}/bookings/quote
Content-Type: application/json

{ "lines": [{ "slug": "canon-eos-r5", "start": "banana", "end": "2026-10-06" }] }

### Rental too long — expect 400, 90-day cap
POST {{api}}/bookings/quote
Content-Type: application/json

{ "lines": [{ "slug": "canon-eos-r5", "start": "2026-10-01", "end": "2027-10-01" }] }

### Empty cart — expect 400
POST {{api}}/bookings/quote
Content-Type: application/json

{ "lines": [] }

###############################################
# Bookings — create (F4/F5)
###############################################

### Create a booking — expect 201
POST {{api}}/bookings
Content-Type: application/json

{
  "lines": [{ "slug": "canon-eos-r5", "start": "2026-11-02", "end": "2026-11-05" }],
  "customer": { "name": "Mohtasim Fahim", "email": "mohtasim@example.com" },
  "pickupMethod": "COUNTER"
}

### Same camera, same dates, twice in one cart — expect 201 with TWO different serials
POST {{api}}/bookings
Content-Type: application/json

{
  "lines": [
    { "slug": "canon-eos-r5", "start": "2026-12-01", "end": "2026-12-03" },
    { "slug": "canon-eos-r5", "start": "2026-12-01", "end": "2026-12-03" }
  ],
  "customer": { "name": "Mohtasim Fahim", "email": "mohtasim@example.com" }
}

### A third time on the same dates — expect 409 UNIT_UNAVAILABLE (only 2 units)
POST {{api}}/bookings
Content-Type: application/json

{
  "lines": [{ "slug": "canon-eos-r5", "start": "2026-12-01", "end": "2026-12-03" }],
  "customer": { "name": "Someone Else", "email": "someone@example.com" }
}

### Bad email — expect 400
POST {{api}}/bookings
Content-Type: application/json

{
  "lines": [{ "slug": "canon-eos-r5", "start": "2026-11-02", "end": "2026-11-05" }],
  "customer": { "name": "Nope", "email": "not-an-email" }
}

### Look a booking up by reference — expect 200
GET {{api}}/bookings/FR-REPLACE-ME

### Unknown reference — expect 404
GET {{api}}/bookings/FR-NOPE-NOPE
