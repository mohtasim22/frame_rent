# Postgres. Use the POOLED host on Neon, and keep sslmode=verify-full.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# The client's origin. Used for CORS and better-auth trustedOrigins.
WEB_ORIGIN="http://localhost:5173"

# This server's own public URL, for better-auth.
API_URL="http://localhost:4000"

# At least 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-me"

PORT=4000
